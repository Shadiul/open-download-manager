<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDownloadManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenDownloadManager.Models"
    Title="Open Download Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.png" Width="18" Height="18" />
                <TextBlock Text="Open Download Manager" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="220"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All downloads" Tag="all" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Unfinished" Tag="active">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE769;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Finished" Tag="completed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Categories" />
                <NavigationViewItem Content="Video" Tag="Video">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Music" Tag="Music">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Documents" Tag="Documents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Programs" Tag="Programs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B8;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Archives" Tag="Archives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF012;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other" Tag="Other">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,8,24,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right" IsOpen="False">
                    <AppBarButton Icon="Add" Label="Add" Click="OnAddClick">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="N" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Icon="Play" Label="Resume" Click="OnResumeClick" />
                    <AppBarButton Icon="Pause" Label="Pause" Click="OnPauseClick" />
                    <AppBarButton Icon="Delete" Label="Remove" Click="OnRemoveClick">
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Delete" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Resume all" Click="OnResumeAllClick">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE768;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Pause all" Click="OnPauseAllClick">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE769;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <CommandBar.SecondaryCommands>
                        <AppBarButton Icon="Up" Label="Move up" Click="OnMoveUpClick" />
                        <AppBarButton Icon="Download" Label="Move down" Click="OnMoveDownClick" />
                        <AppBarButton Icon="Clear" Label="Clear finished" Click="OnClearCompletedClick" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>

                <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />

                <ListView
                    x:Name="List"
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.Visible}"
                    SelectionMode="Extended"
                    IsDoubleTapEnabled="True"
                    DoubleTapped="OnItemDoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadItem">
                            <Grid Padding="4,10" ColumnSpacing="14">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open" Icon="OpenFile" Click="OnOpenClick" />
                                        <MenuFlyoutItem Text="Show in folder" Icon="Folder" Click="OnShowInFolderClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Resume" Icon="Play" Click="OnItemResumeClick" />
                                        <MenuFlyoutItem Text="Pause" Icon="Pause" Click="OnItemPauseClick" />
                                        <MenuFlyoutItem Text="Refresh address" Icon="Refresh" Click="OnRefreshAddressClick" />
                                        <MenuFlyoutItem Text="Speed limit…" Click="OnItemSpeedLimitClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC4A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy address" Icon="Copy" Click="OnCopyAddressClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from list" Icon="Remove" Click="OnItemRemoveClick" />
                                        <MenuFlyoutItem Text="Delete file" Icon="Delete" Click="OnItemDeleteClick" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="22" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ProgressBar
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Maximum="100"
                                    Value="{x:Bind Progress, Mode=OneWay}"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    ShowError="{x:Bind IsFailed, Mode=OneWay}"
                                    Visibility="{x:Bind ShowProgress, Mode=OneWay}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind PercentText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="No downloads here yet" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Click Add, paste a link, or download in Chrome or Edge with the extension installed."
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
