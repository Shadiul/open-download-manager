<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDownloadManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:OpenDownloadManager.Models"
    xmlns:services="using:OpenDownloadManager.Services"
    Title="Open Download Manager">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <!-- Column headers: flat text buttons that sort the list. -->
            <!-- Column headers: subtle buttons (no fill until hovered), like Fluent table headers. -->
            <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Margin" Value="-8,0,0,0" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="SubtleFillColorTransparentBrush" />
            <Style x:Key="Cell" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="MaxLines" Value="1" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/app.png" Width="20" Height="20" />
                <TextBlock Text="Open Download Manager" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            PaneDisplayMode="Auto"
            CompactModeThresholdWidth="700"
            ExpandedModeThresholdWidth="1000"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            OpenPaneLength="210"
            SelectionChanged="OnNavSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="All downloads" Tag="all" IsSelected="True">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE896;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Unfinished" Tag="active">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Finished" Tag="completed">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE930;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Categories" />
                <NavigationViewItem Content="Video" Tag="Video">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Music" Tag="Music">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Documents" Tag="Documents">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Programs" Tag="Programs">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xECAA;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Archives" Tag="Archives">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xF012;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Other" Tag="Other">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid x:Name="Body" Padding="16,4,16,8" RowSpacing="6" SizeChanged="OnBodySizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar: actions on the left, search and view options on the right. On narrow
                     windows the right side moves to its own row (see OnContentSizeChanged). -->
                <Grid x:Name="Toolbar" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Toolbar: subtle Fluent buttons. Labels hide when space is short, leaving
                         compact 36 px icon buttons with tooltips (see OnBodySizeChanged). -->
                    <StackPanel x:Name="Actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <StackPanel.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="9,0" />
                                <Setter Property="Height" Value="34" />
                                <Setter Property="MinWidth" Value="36" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </StackPanel.Resources>
                        <Button Click="OnAddClick" ToolTipService.ToolTip="Add a download (Ctrl+N)" AutomationProperties.Name="Add">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="N" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                                <TextBlock x:Name="LabelAdd" Text="Add" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="20" Margin="4,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Button Click="OnResumeClick" ToolTipService.ToolTip="Resume" AutomationProperties.Name="Resume">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="16" />
                                <TextBlock x:Name="LabelResume" Text="Resume" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnPauseClick" ToolTipService.ToolTip="Pause" AutomationProperties.Name="Pause">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE769;" FontSize="16" />
                                <TextBlock x:Name="LabelPause" Text="Pause" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRemoveClick" ToolTipService.ToolTip="Remove (Delete)" AutomationProperties.Name="Remove">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Delete" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74D;" FontSize="16" />
                                <TextBlock x:Name="LabelRemove" Text="Remove" />
                            </StackPanel>
                        </Button>
                        <Button ToolTipService.ToolTip="More" AutomationProperties.Name="More">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuFlyoutItem Text="Resume all" Click="OnResumeAllClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Pause all" Click="OnPauseAllClick">
                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE769;" /></MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Move up in queue" Icon="Up" Click="OnMoveUpClick" />
                                    <MenuFlyoutItem Text="Move down in queue" Icon="Download" Click="OnMoveDownClick" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Clear finished" Icon="Clear" Click="OnClearCompletedClick" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="Tools" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <AutoSuggestBox x:Name="Search" PlaceholderText="Search downloads" Width="220" QueryIcon="Find"
                                        TextChanged="OnSearchChanged" />
                        <ComboBox x:Name="StatusBox" Width="140" SelectedIndex="0" SelectionChanged="OnStatusFilterChanged"
                                  ToolTipService.ToolTip="Show only downloads in this state">
                            <ComboBoxItem Content="Any status" Tag="any" />
                            <ComboBoxItem Content="Downloading" Tag="downloading" />
                            <ComboBoxItem Content="Queued" Tag="queued" />
                            <ComboBoxItem Content="Paused" Tag="paused" />
                            <ComboBoxItem Content="Finished" Tag="completed" />
                            <ComboBoxItem Content="Failed" Tag="failed" />
                        </ComboBox>
                        <DropDownButton ToolTipService.ToolTip="Choose which columns the list shows">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE9D5;" FontSize="14" />
                                    <TextBlock Text="Columns" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight" Opening="OnViewMenuOpening">
                                    <ToggleMenuFlyoutItem x:Name="ColSize" Text="Size" Click="OnColumnToggle" Tag="size" />
                                    <ToggleMenuFlyoutItem x:Name="ColProgress" Text="Progress and status" Click="OnColumnToggle" Tag="progress" />
                                    <ToggleMenuFlyoutItem x:Name="ColSpeed" Text="Speed" Click="OnColumnToggle" Tag="speed" />
                                    <ToggleMenuFlyoutItem x:Name="ColTimeLeft" Text="Time left" Click="OnColumnToggle" Tag="timeLeft" />
                                    <ToggleMenuFlyoutItem x:Name="ColAdded" Text="Date added" Click="OnColumnToggle" Tag="added" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <DropDownButton ToolTipService.ToolTip="Density, theme and progress windows">
                            <DropDownButton.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                    <TextBlock Text="View" />
                                </StackPanel>
                            </DropDownButton.Content>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="ViewMenu" Placement="BottomEdgeAlignedRight" Opening="OnViewMenuOpening">
                                    <MenuFlyoutSubItem Text="Density">
                                        <RadioMenuFlyoutItem x:Name="DensityCompact" Text="Compact" GroupName="density" Tag="compact" Click="OnDensityClick" />
                                        <RadioMenuFlyoutItem x:Name="DensityStandard" Text="Standard" GroupName="density" Tag="standard" Click="OnDensityClick" />
                                        <RadioMenuFlyoutItem x:Name="DensityComfortable" Text="Comfortable" GroupName="density" Tag="comfortable" Click="OnDensityClick" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSubItem Text="Theme">
                                        <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="Use system setting" GroupName="theme" Tag="system" Click="OnThemeClick" />
                                        <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light" GroupName="theme" Tag="light" Click="OnThemeClick" />
                                        <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark" GroupName="theme" Tag="dark" Click="OnThemeClick" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="ProgressWindows" Text="Open a progress window for each download" Click="OnProgressWindowsToggle" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>

                <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" Severity="Error" IsClosable="True" />

                <!-- Column headers, laid out like the rows below. A chevron marks the sorted column. -->
                <Grid x:Name="Header" Grid.Row="3" Padding="12,0,12,2" ColumnSpacing="12" BorderThickness="0,0,0,1"
                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="SelectAll" MinWidth="0" Padding="0" VerticalAlignment="Center" Click="OnSelectAllClick"
                              ToolTipService.ToolTip="Check all" />
                    <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Tag="name" Click="OnSortClick" Margin="22,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Name" />
                            <FontIcon x:Name="SortName" FontSize="10" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Width="130" Style="{StaticResource HeaderButton}" Tag="size" Click="OnSortClick"
                            Visibility="{x:Bind services:ViewSettings.Current.SizeColumn, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Size" />
                            <FontIcon x:Name="SortSize" FontSize="10" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Width="170" Style="{StaticResource HeaderButton}" Tag="progress" Click="OnSortClick"
                            Visibility="{x:Bind services:ViewSettings.Current.ProgressColumn, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Progress" />
                            <FontIcon x:Name="SortProgress" FontSize="10" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Width="90" Style="{StaticResource HeaderButton}" Tag="speed" Click="OnSortClick"
                            Visibility="{x:Bind services:ViewSettings.Current.SpeedColumn, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Speed" />
                            <FontIcon x:Name="SortSpeed" FontSize="10" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="5" Width="80" Text="Time left" FontSize="12" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{x:Bind services:ViewSettings.Current.TimeLeftColumn, Mode=OneWay}" />
                    <Button Grid.Column="6" Width="110" Style="{StaticResource HeaderButton}" Tag="added" Click="OnSortClick"
                            Visibility="{x:Bind services:ViewSettings.Current.AddedColumn, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Added" />
                            <FontIcon x:Name="SortAdded" FontSize="10" Visibility="Collapsed" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView
                    x:Name="List"
                    Grid.Row="4"
                    ItemsSource="{x:Bind ViewModel.Visible}"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemClick="OnItemClick"
                    IsDoubleTapEnabled="True"
                    DoubleTapped="OnItemDoubleTapped"
                    KeyDown="OnListKeyDown"
                    SizeChanged="OnListSizeChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DownloadItem">
                            <Grid Height="{x:Bind services:ViewSettings.Current.RowHeight, Mode=OneWay}" ColumnSpacing="12" Padding="12,0,12,0"
                                  Background="Transparent" ToolTipService.ToolTip="{x:Bind Detail, Mode=OneWay}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Open" Icon="OpenFile" Click="OnOpenClick" />
                                        <MenuFlyoutItem Text="Show in folder" Icon="Folder" Click="OnShowInFolderClick" />
                                        <MenuFlyoutItem Text="Show progress window" Click="OnShowProgressClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Resume" Icon="Play" Click="OnItemResumeClick" />
                                        <MenuFlyoutItem Text="Pause" Icon="Pause" Click="OnItemPauseClick" />
                                        <MenuFlyoutItem Text="Refresh address" Icon="Refresh" Click="OnRefreshAddressClick" />
                                        <MenuFlyoutItem Text="Speed limit…" Click="OnItemSpeedLimitClick">
                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEC4A;" /></MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutItem Text="Copy address" Icon="Copy" Click="OnCopyAddressClick" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Text="Remove from list" Icon="Remove" Click="OnItemRemoveClick" />
                                        <MenuFlyoutItem Text="Delete file" Icon="Delete" Click="OnItemDeleteClick" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The row is the progress bar: a fill that glides to the new progress, with a
                                     shimmer while bytes arrive. Amber when paused, red when failed; fades when done. -->
                                <Grid Grid.ColumnSpan="6" Margin="-12,3,-12,3" CornerRadius="4" IsHitTestVisible="False"
                                      Background="{x:Bind FillBrush, Mode=OneWay}"
                                      Scale="{x:Bind FillScale, Mode=OneWay}" CenterPoint="0,0,0"
                                      Opacity="{x:Bind FillOpacity, Mode=OneWay}"
                                      Loaded="OnRowFillLoaded">
                                    <Grid.ScaleTransition>
                                        <Vector3Transition Duration="0:0:0.45" />
                                    </Grid.ScaleTransition>
                                    <Grid.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.6" />
                                    </Grid.OpacityTransition>
                                    <Rectangle Width="140" HorizontalAlignment="Left" Visibility="{x:Bind IsShimmering, Mode=OneWay}">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#2EFFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform />
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Grid>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Checking is separate from clicking: a click on the row only checks it
                                         once something is already checked (see OnItemClick). -->
                                    <CheckBox MinWidth="0" Width="20" Padding="0" VerticalAlignment="Center"
                                              IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                              AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}" />
                                    <Grid Grid.Column="1" Width="{x:Bind services:ViewSettings.Current.IconSize, Mode=OneWay}"
                                          Height="{x:Bind services:ViewSettings.Current.IconSize, Mode=OneWay}" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16"
                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                  Visibility="{x:Bind NoIcon, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{x:Bind DisplayName, Mode=OneWay}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"
                                               FontSize="{x:Bind services:ViewSettings.Current.RowFontSize, Mode=OneWay}" />
                                </Grid>
                                <TextBlock Grid.Column="1" Width="130" Style="{StaticResource Cell}" Text="{x:Bind SizeText, Mode=OneWay}"
                                           Visibility="{x:Bind services:ViewSettings.Current.SizeColumn, Mode=OneWay}" />
                                <!-- Progress as text; the row itself shows it as a fill. -->
                                <StackPanel Grid.Column="2" Width="170" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            Visibility="{x:Bind services:ViewSettings.Current.ProgressColumn, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind StateGlyph, Mode=OneWay}" FontSize="12" Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                              Visibility="{x:Bind StateVisible, Mode=OneWay}" />
                                    <TextBlock Style="{StaticResource Cell}" Text="{x:Bind ProgressText, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Width="90" Style="{StaticResource Cell}" Text="{x:Bind SpeedText, Mode=OneWay}"
                                           Visibility="{x:Bind services:ViewSettings.Current.SpeedColumn, Mode=OneWay}" />
                                <TextBlock Grid.Column="4" Width="80" Style="{StaticResource Cell}" Text="{x:Bind TimeLeftText, Mode=OneWay}"
                                           Visibility="{x:Bind services:ViewSettings.Current.TimeLeftColumn, Mode=OneWay}" />
                                <TextBlock Grid.Column="5" Width="110" Style="{StaticResource Cell}" Text="{x:Bind AddedText, Mode=OneWay}"
                                           Visibility="{x:Bind services:ViewSettings.Current.AddedColumn, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsHitTestVisible="False"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                    <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Click Add, paste a link, or download in Chrome or Edge with the extension installed."
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid Grid.Row="5" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SelectionText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
